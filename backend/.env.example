# MarketHub backend — environment template. Copy to .env and fill values.
# NEVER commit real credentials; secrets live ONLY in env/user-secrets in production.

# ---------- compose / infrastructure ----------
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=markethub;Username=postgres;Password=postgres
Redis__ConnectionString=localhost:6379
Jwt__Key=dev-only-key-change-me-in-production-0123456789-0123456789-0123456789
Jwt__Issuer=MarketHub
Jwt__Audience=MarketHubClients
Cors__Origins=http://localhost:3000

# ---------- file storage (Local dev | MinIO prod) ----------
FileStorage__Provider=Local
FileStorage__LocalRoot=filestorage
# MinIO prod: Minio__Endpoint / Minio__AccessKey / Minio__SecretKey / Minio__Bucket

# ---------- payments (Mock | Chapa | Telebirr | Santimpay) ----------
Payments__Provider=Mock
Chapa__ApiKey=
Chapa__WebhookSecret=
Telebirr__AppId=
Telebirr__AppKey=
Telebirr__PublicKey=
Santimpay__MerchantId=
Santimpay__ApiKey=

# ---------- SMS (Mock | EthioTelecom | Safaricom) — GAP-FILL v2 ----------
Sms__Provider=Mock
EthioTelecom__Endpoint=
EthioTelecom__ApiKey=
EthioTelecom__SenderId=MarketHub
Safaricom__Endpoint=
Safaricom__ApiKey=
Safaricom__Shortcode=MARKETHUB

# ---------- Email (Mock | Smtp) — GAP-FILL v2 ----------
Email__Provider=Mock
Smtp__Host=localhost
Smtp__Port=1025
Smtp__User=
Smtp__Pass=
Smtp__From=no-reply@markethub.et

# ---------- Search (Meilisearch | Null → SQL ILIKE fallback) — GAP-FILL v2 ----------
Search__Provider=Meilisearch
Meilisearch__Host=http://localhost:7700
Meilisearch__ApiKey=
Meilisearch__IndexPrefix=markethub

# ---------- CDN base for product media — GAP-FILL v2 ----------
Cdn__BaseUrl=https://z-cdn.chatglm.cn/image-search-mcp/images-ppt
